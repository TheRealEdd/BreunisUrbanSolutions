{
  "media": {
    "input": "images/blog",
    "output": "/images/blog"
  },
  "content": [
    {
      "name": "posts",
      "label": "Blog Posts",
      "type": "collection",
      "path": "posts",
      "extension": "md",
      "format": "frontmatter-markdown",
      "fields": [
        {
          "name": "title",
          "label": "Post Title",
          "type": "string",
          "required": true
        },
        {
          "name": "date",
          "label": "Publish Date",
          "type": "date",
          "required": true
        },
        {
          "name": "description",
          "label": "Short Summary",
          "type": "text"
        },
        {
          "name": "body",
          "label": "Blog Content",
          "type": "markdown",
          "required": true
        }
      ]
    }
  ]
}